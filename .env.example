# Copy to .env.local; never commit secrets.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
OPENAI_API_KEY=
# Optional OpenAI-compatible gateway.
OPENAI_BASE_URL=https://litellm.vision.aivar.app/v1
OPENAI_MODEL=claude-sonnet-4.6
NEATLOGS_API_KEY=
NEATLOGS_ENDPOINT=https://ingest.neatlogs.com
APP_BASE_URL=http://127.0.0.1:3000
WORKER_SECRET=
PUBLIC_DEMO_ENABLED=false
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
SESSION_SECRET=
GLOBAL_MODEL_BUDGET_USD=10
PUBLIC_MODEL_BUDGET_USD=5
SANDBOX_MODEL_BUDGET_USD=0.25
# Explicit price ceilings USD per million tokens; confirm provider pricing before live use.
MODEL_INPUT_USD_PER_MILLION=3.3
MODEL_OUTPUT_USD_PER_MILLION=16.5
MODEL_API=chat
# Private development allowance; public sandboxes keep the limit above.
LOCAL_SANDBOX_MODEL_BUDGET_USD=1
